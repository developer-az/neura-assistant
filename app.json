{
  "expo": {
    "name": "Baseline",
    "slug": "baseline-notebook",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF1F4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.baseline.notebook",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EEF1F4"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.baseline.notebook"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "c29dbcb9-babb-4264-a5ed-657799ef4cbe"
      }
    }
  }
}
